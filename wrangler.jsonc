{
  // Cloudflare Workers only (not used for Vercel). Re-enable `cloudflare` in vite.config + install @cloudflare/vite-plugin to use this.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
}
