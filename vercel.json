{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kindred-peoplesolutions.vercel.app"
        }
      ],
      "destination": "https://www.rightkind.co/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "initial-source-code.vercel.app"
        }
      ],
      "destination": "https://www.rightkind.co/:path*",
      "permanent": true
    }
  ]
}
